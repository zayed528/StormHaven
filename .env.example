# Copy to .env (never commit .env)
AWS_REGION=us-east-2
# Production CORS: comma-separated Vercel origin(s); never use * in production.
STORMHAVEN_CORS_ORIGINS=http://localhost:5173
# Production startup: download and require the approved private S3 runtime bundle.
STORMHAVEN_DATA=real
STORMHAVEN_S3_ENABLED=true
STORMHAVEN_S3_BUCKET=stormhaven-artifacts-153087143030
STORMHAVEN_S3_PREFIX=real-data/
# Keep operator and notification routes disabled until authenticated boundaries exist.
STORMHAVEN_ENABLE_OPERATOR_ROUTES=false
STORMHAVEN_ENABLE_NOTIFY=false
# Verified non-secret Bedrock configuration. Credentials must come from the standard AWS provider chain.
# Clear BEDROCK_MODEL_ID to run with deterministic offline chat only.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_GUARDRAIL_ID=vibbustudfu7
BEDROCK_GUARDRAIL_VERSION=1
# Keep customer-facing chat responsive and bound automatic retries.
BEDROCK_CONNECT_TIMEOUT_SECONDS=3
BEDROCK_READ_TIMEOUT_SECONDS=12
BEDROCK_MAX_ATTEMPTS=2
# SNS topic with the demo phones subscribed (SMS sandbox: verify each number first). Blank = dry-run, nothing is sent.
SNS_TOPIC_ARN=
