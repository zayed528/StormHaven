# Copy to .env (never commit .env)
AWS_REGION=us-east-2
# Verified non-secret Bedrock configuration. Credentials must come from the standard AWS provider chain.
# Clear BEDROCK_MODEL_ID to run with deterministic offline chat only.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_GUARDRAIL_ID=vibbustudfu7
BEDROCK_GUARDRAIL_VERSION=1
# Keep customer-facing chat responsive and bound automatic retries.
BEDROCK_CONNECT_TIMEOUT_SECONDS=3
BEDROCK_READ_TIMEOUT_SECONDS=12
BEDROCK_MAX_ATTEMPTS=2
# SNS topic with the demo phones subscribed (SMS sandbox: verify each number first). Blank = dry-run, nothing is sent.
SNS_TOPIC_ARN=
